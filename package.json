{
  "name": "agent-fables",
  "version": "0.1.0",
  "private": true,
  "description": "Offline agent-safety preflight and revision-pinned evidence for destructive operations, tool calls, and software-agent failures.",
  "repository": { "type": "git", "url": "git+https://github.com/AaronVick/AGENT_FABLES.git" },
  "bugs": { "url": "https://github.com/AaronVick/AGENT_FABLES/issues" },
  "homepage": "https://github.com/AaronVick/AGENT_FABLES",
  "scripts": {
    "build": "npm run build:corpus && npm run build:retrieval && npm run build:metrics",
    "build:corpus": "node build-data.mjs",
    "build:retrieval": "node build-signatures.mjs && node build-leaders.mjs && node build-hotpath.mjs && node build-sandbox.mjs",
    "build:metrics": "node scripts/metrics.mjs --write",
    "af": "node bin/agent-fables.mjs",
    "metrics": "node scripts/metrics.mjs",
    "growth-simulation": "node scripts/growth-simulation.mjs",
    "eval:sandbox": "node sandbox/agent-fables-sandbox.mjs eval",
    "launch-audit": "node bin/agent-fables.mjs launch-audit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test && npm --prefix api run check && npm --prefix api test && npm --prefix web run build"
  },
  "keywords": [
    "ai-agents",
    "agent-safety",
    "incident-data",
    "llm-security",
    "mcp"
    , "destructive-operations"
    , "preflight"
    , "agent-guardrails"
    , "operational-safety"
  ],
  "license": "CC0-1.0",
  "type": "module",
  "bin": {
    "agent-fables": "bin/agent-fables.mjs",
    "agent-fables-mcp": "mcp/server.mjs"
  },
  "mcpName": "org.agentfables/agent-safety-preflight",
  "engines": { "node": ">=20" },
  "files": [
    "bin/",
    "mcp/",
    "lib/",
    "fables/",
    "incidents/",
    "signatures/",
    "schemas/",
    "index.json",
    "index.jsonl",
    "memory.jsonl",
    "incidents.json",
    "search-index.json",
    "tool-index.jsonl",
    "tool-index-retrieval.jsonl",
    "tool-capability-aliases.json",
    "utterance-index.jsonl",
    "hotpath.json",
    "hotpath.min.json",
    "overlaps.json",
    "cite-contract.json",
    "external-cite-contract.json",
    "predicate-registry.json",
    "authority-precedence.json",
    "request-framing-independence.json",
    "delegation-scope.json",
    "INJECT.txt",
    "cards/",
    "trust.json",
    "steward.json",
    "contact-policy.json",
    "capabilities.json",
    "steward-works.json",
    "design-principles.json",
    "discovery.json",
    "scanner-rules.json",
    "guardrail-contract.json",
    "freshness.json",
    "evidence-coverage.json",
    "eval-report.json",
    "metrics-report.json",
    "consumer-obligations.json",
    "contribution-contract.json",
    "adoption-kit.json",
    "publication-state.json",
    "leaders.json",
    "leaders/",
    "skills/agent-fables-preflight/",
    "integrations/",
    ".agentfablesignore",
    "server.json",
    "bundle.md",
    "START_HERE.md",
    "agent-entry.json",
    "SANDBOX.md",
    "sandbox/agent-fables-sandbox.mjs",
    "AGENT-ROUTES.md",
    "CONTRIBUTING_AGENTS.md",
    "STEWARD.md",
    "SECURITY.md",
    "repository-metadata.json",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
