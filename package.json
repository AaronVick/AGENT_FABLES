{
  "name": "agent-fables",
  "version": "1.0.0",
  "private": true,
  "description": "Offline agent-safety preflight and revision-pinned evidence for destructive operations, tool calls, and software-agent failures.",
  "scripts": {
    "build": "npm run build:corpus && npm run build:retrieval",
    "build:corpus": "node build-data.mjs",
    "build:retrieval": "node build-signatures.mjs && node build-leaders.mjs",
    "af": "node bin/agent-fables.mjs",
    "metrics": "node scripts/metrics.mjs",
    "launch-audit": "node bin/agent-fables.mjs launch-audit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test && npm --prefix api run check && npm --prefix api test && npm --prefix web run build"
  },
  "keywords": [
    "ai-agents",
    "agent-safety",
    "incident-data",
    "llm-security",
    "mcp"
    , "destructive-operations"
    , "preflight"
    , "agent-guardrails"
    , "operational-safety"
  ],
  "license": "CC0-1.0",
  "type": "module",
  "bin": {
    "agent-fables": "bin/agent-fables.mjs",
    "agent-fables-mcp": "mcp/server.mjs"
  },
  "mcpName": "org.agentfables/agent-safety-preflight",
  "engines": { "node": ">=20" },
  "files": [
    "bin/",
    "mcp/",
    "lib/",
    "fables/",
    "incidents/",
    "signatures/",
    "schemas/",
    "index.json",
    "index.jsonl",
    "memory.jsonl",
    "incidents.json",
    "search-index.json",
    "trust.json",
    "steward.json",
    "contact-policy.json",
    "capabilities.json",
    "steward-works.json",
    "design-principles.json",
    "discovery.json",
    "scanner-rules.json",
    "leaders.json",
    "leaders/",
    "integrations/",
    ".agentfablesignore",
    "server.json",
    "bundle.md",
    "AGENT-ROUTES.md",
    "CONTRIBUTING_AGENTS.md",
    "STEWARD.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "js-yaml": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
