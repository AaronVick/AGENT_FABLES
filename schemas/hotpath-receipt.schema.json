{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentfables.org/schemas/hotpath-receipt.schema.json","type":"object","additionalProperties":false,"required":["schema_version","route","match","reason","authority","authorized","corpus_revision","cards","similar_rejected","required_verifications","cite"],"properties":{"schema_version":{"const":"1.0.0"},"route":{"const":"tool-call-hotpath"},"match":{"enum":["hit","none"]},"reason":{"enum":["corpus_hit","no_corpus_hit","near_miss_only","ambiguous"]},"authority":{"const":"none"},"authorized":{"const":false},"corpus_revision":{"pattern":"^sha256:[a-f0-9]{64}$"},"trigger_id":{"type":["string","null"]},"cards":{"type":"array","maxItems":2},"similar_rejected":{"type":"array","maxItems":2,"items":{"pattern":"^AF-[0-9]{4}$"}},"required_verifications":{"type":"array","minItems":1,"items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"const":"unverified"}},"additionalProperties":true}},"cite":{"oneOf":[{"type":"null"},{"type":"array","minItems":1,"maxItems":2,"items":{"type":"object","required":["id","corpus_revision","card_rev","source"],"properties":{"id":{"pattern":"^AF-[0-9]{4}$"},"corpus_revision":{"pattern":"^sha256:[a-f0-9]{64}$"},"card_rev":{"pattern":"^sha256:[a-f0-9]{64}$"},"source":{"const":"card"}},"additionalProperties":false}}]}},"allOf":[{"if":{"properties":{"match":{"const":"none"}}},"then":{"properties":{"cards":{"maxItems":0},"cite":{"type":"null"}}}},{"if":{"properties":{"match":{"const":"hit"}}},"then":{"properties":{"cards":{"minItems":1},"cite":{"type":"array","minItems":1}}}}]}
