{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfables.org/schemas/incident.schema.json",
  "title": "Agent Fables incident",
  "type": "object",
  "required": ["id", "title", "occurred_at", "status", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^AFI-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date" },
    "status": { "enum": ["publicly-reported", "vendor-confirmed", "disputed", "retracted"] },
    "evidence_grade": { "enum": ["A-primary-source", "B-indexed-public-report", "C-secondary-only"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "kind": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["primary", "secondary"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
